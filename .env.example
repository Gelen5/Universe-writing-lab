# 飞书自建应用凭证（也可写在 config.json 的 feishu 段，二选一）
# 获取：飞书开放平台 → 创建企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 知识库空间：wiki URL 中的节点 token（my.feishu.cn/wiki/XXXX 的 XXXX）
FEISHU_SPACE_ID=

# 可选：指定归档父节点 token；留空则自动解析为空间根目录
FEISHU_PARENT_NODE=

# 可选：微信公众号素材/数据 API（mode=mp_api 时需要）
WECHAT_APPID=
WECHAT_SECRET=
